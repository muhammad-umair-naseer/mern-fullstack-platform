# Copy to server/.env and fill in your values.
#
# JWT_SECRET  long random string; rotating it signs every learner out.
#             Required: there is no default, and docker compose refuses to
#             start without it. Never reuse a value that was ever committed.
#             generate with:
#             node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# SMTP_*      Gmail needs an App Password (Google Account > Security >
#             2-Step Verification > App passwords), not your login password.
# CONTACT_TO  where contact-form enquiries are delivered.
# ADMIN_ALERT_TO  where operational alerts and new-signup notices go.
# GAME_SSO_SECRET signs the 10-minute tokens that sign learners in to the games.
#             Set the SAME value for the API and every game server. Unset in
#             development = a shared dev constant for player sign-in only (with
#             a warning; the admin portal's game player tools stay off); unset in
#             production = game sign-in stays off. docker compose requires it.
# POSTGRES_PASSWORD, REDIS_PASSWORD, ADMIN_EMAIL, ADMIN_PASSWORD have no
#             defaults in docker-compose.yml either: compose stops with a
#             message naming the missing one.
# TRUST_PROXY how many reverse proxies sit in front of the API (Express
#             'trust proxy'). Leave unset locally (false). Behind one TLS
#             proxy in production set 1, so rate limits see each visitor's IP
#             rather than the proxy's.
# CORS_ORIGINS comma-separated origins allowed to call the API from a
#             browser. Unset = http://localhost:3000 and http://localhost:6001
#             (plus the same ports on LAN hosts outside production).
# ADMIN_ALLOWED_IPS comma-separated client IPs allowed to use /api/admin.
#             Empty = any IP (the admin password still applies).

# Copy to .env and fill your values
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cortexis_db

# Redis Configuration (Optional: application gracefully falls back to SQLite if absent)
# Connection URL format: redis://[:password@]host[:port][/db]
REDIS_URL=
# Or discrete parameters:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=2000
# BullMQ Background Worker mode: true (in-process with Express) or false (standalone process)
EMBEDDED_WORKER=true

# Optional: enable email sending for contact submissions
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
# Signing key for learner session tokens — keep secret, rotating it signs everyone out
JWT_SECRET=

# Where operational alerts and new-signup notices go. Separate from CONTACT_TO,
# which is for business enquiries from the contact form.
ADMIN_ALERT_TO=
# The admin portal (port 6001) has one account, made from these two at every
# boot: no sign-up. Change the password here and restart to change it.
# At least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared with the games (same value in their environment)
GAME_SSO_SECRET=

TRUST_PROXY=
CORS_ORIGINS=
ADMIN_ALLOWED_IPS=
