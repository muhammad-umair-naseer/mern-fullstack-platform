# Copy to server/.env and fill in your values.
#
# JWT_SECRET  long random string; rotating it signs every learner out.
#             generate with:
#             node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SMTP_*      Gmail needs an App Password (Google Account > Security >
#             2-Step Verification > App passwords), not your login password.
# CONTACT_TO  where contact-form enquiries are delivered.
# ADMIN_ALERT_TO  where operational alerts and new-signup notices go.

# Copy to .env and fill your values
PORT=
DATABASE_FILE=
# Optional: enable email sending for contact submissions
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
# Signing key for learner session tokens — keep secret, rotating it signs everyone out
JWT_SECRET=

# Where operational alerts and new-signup notices go. Separate from CONTACT_TO,
# which is for business enquiries from the contact form.
ADMIN_ALERT_TO=
