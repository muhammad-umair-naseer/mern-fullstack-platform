# Only client/ and server/ are copied into the image; everything else is
# excluded so the build context stays small and no secret can ride along.
node_modules/
client/node_modules/
server/node_modules/
client/build/
server/data/
server/test/
.env
.env.*
server/.env
server/.env.*
!server/.env.example
.git/
.github/
.gitignore
.vscode/
.idea/
.claude/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
# Prototype folders and standalone HTML experiments kept in the repository
Image Color Picker/
brand-source/
image-enlarger/
image-resizer/
local-image-compressor/
local-image-compressor-main/
local-pdf-image-tools-main/
png-compressor/
qr-generator/
tool1-client/
tool2-compressor/
tool3-merger/
tool4-splitter/
tool7-crop/
tool8-resize/
*.html
