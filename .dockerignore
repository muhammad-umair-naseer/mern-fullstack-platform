# The runtime image only consumes these inputs. Admin and games have their own contexts.
**
!Dockerfile
!server/
!server/package.json
!server/package-lock.json
!server/src/
!server/src/**
!server/scripts/
!server/scripts/**
!client/
!client/build/
!client/build/**

# Never send credentials, local data or editor leftovers, even under allowed paths.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.db
**/*.db-wal
**/*.db-shm
**/*.bak*
**/*.log
**/node_modules
