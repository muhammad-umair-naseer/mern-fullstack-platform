# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build outputs
dist/
build/
client/build/
server/build/

# Environment variables
.env
.env.*
server/.env
server/.env.*
*.bak
*.bak*
!.env.example
!server/.env.example

# Cache
.cache/
client/node_modules/.cache/
server/node_modules/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Claude Code local tooling
.claude/

# Large media files
uploads/
extracted_tools/
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.rar
*.tar.gz
*.pst
*.sql
!/deploy/*.sql
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*.p12

# Lockfiles are committed on purpose: npm ci and every Docker build depend on them.

# SQLite write-ahead log sidecars
*.db-wal
*.db-shm

# Large test/dummy files
dummy-500MB.pdf
*.dummy.pdf

backups/
!client/.env.example

# Local application data and disposable test output
/data/
/games/*/data/
coverage/
test-results/
playwright-report/
*.tmp

# Recreated from client/package-lock.json by npm run sync:vendors.
# Keep hand-maintained vendor assets outside this list tracked.
/client/public/vendor/qpdf/
/client/public/vendor/pdf.min.mjs
/client/public/vendor/pdf.worker.min.mjs
/client/public/vendor/standard_fonts/
/client/public/vendor/pdfjs-wasm/
/client/public/vendor/tesseract/
