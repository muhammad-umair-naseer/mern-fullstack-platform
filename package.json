{
  "name": "cortexis-platform",
  "version": "1.0.0",
  "description": "Cortexis React website, PostgreSQL API, staff portal and games",
  "main": "server/src/server.js",
  "scripts": {
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "start:all": "node scripts/start-all.mjs",
    "start:games": "node scripts/start-games.mjs",
    "start:client": "npm start --prefix client",
    "start:gotcha": "node scripts/start-service.mjs gotcha",
    "start:typedash": "node scripts/start-service.mjs typedash",
    "start:pickparty": "node scripts/start-service.mjs pickparty",
    "start:sketch": "node scripts/start-service.mjs sketch",
    "start:admin": "node scripts/start-service.mjs admin",
    "start:yourbot": "node scripts/start-yourbot.mjs",
    "test": "npm test --prefix server && npm test --prefix client && node --test admin/test/*.test.js",
    "install:all": "npm ci --prefix server && npm ci --prefix client",
    "lint": "npm run lint --prefix client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=24.13.1 <25"
  }
}
