# Copy to .env next to docker-compose.yml before `docker compose up`.
# Every value here is required; compose refuses to start without them, so a
# forgotten secret can never fall back to something a public repository knows.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
GAME_SSO_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# The one admin account, made from these at every boot (password: 12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional — outbound email for the contact form, verification codes and alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
ADMIN_ALERT_TO=

# Optional — host ports for the three games (defaults 3001, 4001, and 5001).
GOTCHA_PORT=3001
TYPEDASH_PORT=4001
PICKPARTY_PORT=5001

