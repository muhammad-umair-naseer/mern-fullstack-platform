# Docker Compose production configuration. Copy to .env; keep it outside Git.
SITE_URL=https://example.com
ADMIN_URL=https://admin.example.com
CORS_ORIGINS=https://example.com,https://admin.example.com
# Generate distinct random values: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
GAME_SSO_SECRET=
EMAIL_QUEUE_SECRET=
POSTGRES_PASSWORD=
# Distinct base64url secret (at least 32 characters) for the restricted web role.
APP_DB_PASSWORD=
REDIS_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where replies to outgoing emails go (the contact form uses the visitor instead).
SMTP_REPLY_TO=
SMTP_FROM=
CONTACT_TO=
ADMIN_ALERT_TO=
EMBEDDED_WORKER=true
# Enable games only after configuring HTTPS subdomains, Nginx and these exact origins.
GAME_ORIGINS=
REACT_APP_GAME_GOTCHA_URL=
REACT_APP_GAME_TYPEDASH_URL=
REACT_APP_GAME_PICKPARTY_URL=
REACT_APP_GAME_SKETCH_URL=
REACT_APP_YOURBOT_URL=
